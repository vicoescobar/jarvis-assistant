APP_NAME=Jarvis
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Paris
APP_URL=https://jarvis-api.victor-giroud.fr
FRONTEND_URL=https://jarvis-dashboard.victor-giroud.fr

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/storage/app/sqlite/database.sqlite

SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

JARVIS_OWNER_EMAIL=owner@example.com
JARVIS_OWNER_PASSWORD=change_me_strong_password
N8N_INTERNAL_URL=http://jarvis-n8n:5678
USER_DATA_PATH=/var/www/user_data
